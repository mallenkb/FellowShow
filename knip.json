{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/broadcast-output.tsx!",
    "data/**/*.ts",
    "scripts/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "src/**/*.css!",
    "data/**/*.ts",
    "scripts/**/*.ts"
  ],
  "ignoreBinaries": ["optimum-cli", "powershell"],
  "ignoreFiles": [
    "src/components/ui/sheet.tsx",
    "src/components/ui/sidebar.tsx",
    "src/hooks/use-mobile.ts"
  ],
  "tags": ["-public"]
}
