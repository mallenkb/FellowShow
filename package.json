{
  "name": "fellowshow",
  "version": "0.1.51",
  "packageManager": "bun@1.3.14",
  "description": "Real-time AI-powered Bible verse detection for live sermons and broadcasts.",
  "license": "MIT",
  "homepage": "https://github.com/mallenkb/FellowShow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mallenkb/FellowShow.git"
  },
  "bugs": {
    "url": "https://github.com/mallenkb/FellowShow/issues"
  },
  "keywords": [
    "bible",
    "broadcast",
    "tauri",
    "react",
    "rust",
    "ndi",
    "speech-to-text"
  ],
  "type": "module",
  "scripts": {
    "audit:songs": "bun run scripts/audit-songs.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepare:document-converter": "bun run scripts/prepare-document-converter.ts",
    "lint": "eslint .",
    "knip": "knip",
    "check:tauri-versions": "bun run scripts/check-tauri-versions.ts",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "tauri": "bun run scripts/tauri.ts",
    "dev:fast": "bun run tauri dev --config src-tauri/tauri.fast-dev.conf.json",
    "test": "vitest",
    "download:bible-data": "bun run data/download-sources.ts",
    "download:asante-twi": "bun run data/download-asante-twi.ts",
    "import:tk2012": "bun run data/import-tk2012.ts",
    "download:thiagobodruk-bibles": "bun run data/download-thiagobodruk-bibles.ts",
    "build:bible": "bun run data/build-bible-db.ts",
    "prepare:release-bible": "bun run data/prepare-release-bible.ts",
    "prepare:r2-content": "bun run data/prepare-r2-content.ts",
    "publish:r2-content": "bun run data/publish-r2-content.ts",
    "release:bundled": "bun run prepare:release-bible && bun run prepare:document-converter && bun run tauri build",
    "release:r2": "bun run download:asante-twi && bun run prepare:r2-content && bun run publish:r2-content",
    "download:model": "bun run data/download-model.ts",
    "export:verses": "bun run data/compute-embeddings.ts",
    "quantize:model": "optimum-cli onnxruntime quantize --onnx_model models/qwen3-embedding-0.6b/ --arm64 -o models/qwen3-embedding-0.6b-int8/",
    "precompute:embeddings-onnx": "bun run data/run-python.ts data/precompute-embeddings-onnx.py",
    "precompute:embeddings-py": "bun run data/run-python.ts data/precompute-embeddings.py",
    "precompute:embeddings": "cd src-tauri && cargo run -p fellowshow-detection --features precompute-bin --release --bin precompute -- --model ../models/qwen3-embedding-0.6b/model.onnx --tokenizer ../models/qwen3-embedding-0.6b/tokenizer.json --verses ../data/verses-for-embedding.json --output-embeddings ../embeddings/kjv-qwen3-0.6b.bin --output-ids ../embeddings/kjv-qwen3-0.6b-ids.bin",
    "download:whisper": "bun run data/download-whisper-model.ts",
    "download:ndi-sdk": "bun run data/download-ndi-sdk.ts",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "setup:all": "bun run data/prepare-embeddings.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "~2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.57.0",
    "motion": "^12.42.2",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-joyride": "^3.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "^1.4.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "esbuild": "0.28.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "prosemirror-model": "^1.25.12",
    "prosemirror-view": "^1.42.6",
    "undici": "7.29.1",
    "ws": "8.21.0"
  }
}
